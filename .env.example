# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://techysolutions.com

# Optional: send contact-form enquiries straight into ERPNext as Leads.
# Create an API key/secret for an integration user with permission to create Leads and Comments.
FRAPPE_URL=https://erp.techysolutions.com
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Optional: store contact-form enquiries in Turso (libSQL). Table is created on first submit.
# Token: Turso dashboard → database → Create Token.
TURSO_DATABASE_URL=libsql://techysolutions-technical-shree.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=
